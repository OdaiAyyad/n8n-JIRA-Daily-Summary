    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst dayOfWeek = now.getDay(); // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat\n\nlet daysBack;\n\nif (dayOfWeek === 6) {\n  // Saturday → look back to Wednesday (3 days)\n  daysBack = 3;\n} else {\n  // All other working days → look back 1 day\n  daysBack = 1;\n}\n\nconst reportDate = new Date(Date.now() - daysBack * 86400000);\nconst reportDateStr = reportDate.toISOString().slice(0, 10);\n\nreturn [{ json: { reportDate: reportDateStr } }];"
      },
