      "name": "Merge Tickets"
    },
    {
      "parameters": {
        "jsCode": "const seenTested = new Set();\nconst seenBugs = new Set();\nconst tested = [];\nconst bugs = [];\nconst myAccountId = '712020:73241cb0-4434-4afb-a9c9-1a320a644c30';\nconst reportDate = $('Calculate Report Date').first().json.reportDate;\n\nfunction iCommentedOnReportDate(item) {\n  const comments = item.json.fields?.comment?.comments || [];\n  return comments.some(c =>\n    c.author?.accountId === myAccountId &&\n    c.created?.slice(0, 10) === reportDate\n  );\n}\n\nfor (const item of $input.all()) {\n  const key = item.json.key;\n  const summary = item.json.fields.summary;\n  const status = item.json.fields.status?.name || 'Unknown';\n  const link = `https://joacademydev.atlassian.net/browse/${key}`;\n  const isAssigned = item.json._assignedToMe === true;\n  const iCommented = iCommentedOnReportDate(item);\n\n  if (isAssigned || iCommented) {\n    if (!seenTested.has(key)) {\n      seenTested.add(key);\n      seenBugs.add(key);\n      tested.push({ key, summary, status, link });\n    }\n  } else {\n    if (!seenBugs.has(key) && !['cancel', 'canceled', 'cancelled'].includes(status.toLowerCase())) {\n      seenBugs.add(key);\n      bugs.push({ key, summary, status, link });\n    }\n  }\n}\n\nreturn [{ json: { tested, bugs } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        208
      ],
      "id": "4e1ef6fe-96d1-4232-a048-5147a2bb133d",
      "name": "Split & Deduplicate"
    },
    {
      "parameters": {
        "sendTo": "odai.mohammad@joacademy.com",
        "subject": "=📋 Jira Daily Summary — {{ new Date($('Calculate Report Date').first().json.reportDate).toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}) }}",
        "message": "=<h2>📋 Your Jira Summary</h2>\n\n<h3>✅ Tickets I Tested</h3>\n<ul>\n{{ $json.tested.map(item => `\n<li>\n<b>${item.key}</b> — ${item.summary}<br>\nStatus: ${item.status}<br>\n<a href=\"${item.link}\">${item.link}</a>\n</li>\n`).join('') }}\n</ul>\n\n<h3>🐛 Bugs I Opened</h3>\n<ul>\n{{ $json.bugs.map(item => `\n<li>\n<b>${item.key}</b> — ${item.summary}<br>\nStatus: ${item.status}<br>\n<a href=\"${item.link}\">${item.link}</a>\n</li>\n`).join('') }}\n</ul>\n\n<hr>\n\n<h3>📋 Copy for Timesheet</h3>\n\n<b>I tested:</b><br>\n<pre>{{ $json.tested.map(item => item.link).join('\\n') }}</pre>\n\n<br><br>\n\n<b>I opened:</b><br>\n<pre>{{ $json.bugs.map(item => item.link).join('\\n') }}</pre>",
        "options": {}
      },
